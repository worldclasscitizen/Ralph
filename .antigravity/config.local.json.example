{
  "$schema": "./config.local.schema.json",
  "schemaVersion": "3.0",
  "kind": "ralph-orchestration-local-config",
  "spec": "./config.json",
  "ownerLabel": "YOUR_NAME",
  "_comment": [
    "이 예시는 Gemini와 Claude를 쓰는 사용자의 완전한 개인 설정이다.",
    "본인이 사용하지 않는 Provider와 모델은 삭제하고 모든 taskPipelines와 Ralph fallbackChains를 남은 모델로 다시 지정한다.",
    "Claude Code 구독 로그인형은 ANTHROPIC_API_KEY를 사용하지 않는다.",
    "API 키 값은 JSON에 쓰지 않고 connection.apiKeyEnv에 환경변수 이름만 적는다.",
    "critic chain은 가능하면 서로 다른 공급자 모델 2개 이상으로 구성한다. Post-Critic은 실제 Worker와 다른 alias를 우선하고 경계 점수 재심은 Worker와 1차 Critic 모두와 다른 모델을 사용한다."
  ],
  "providers": {
    "google": {
      "catalogProvider": "google",
      "enabled": true,
      "connection": {
        "mode": "builtin"
      }
    },
    "anthropic": {
      "catalogProvider": "anthropic",
      "enabled": true,
      "connection": {
        "mode": "builtin"
      }
    }
  },
  "models": {
    "gemini-flash": {
      "catalogModel": "gemini-flash",
      "reasoningEffort": "high"
    },
    "claude-fable": {
      "catalogModel": "claude-fable",
      "reasoningEffort": "max"
    },
    "claude-opus": {
      "catalogModel": "claude-opus",
      "reasoningEffort": "max"
    },
    "claude-sonnet": {
      "catalogModel": "claude-sonnet",
      "reasoningEffort": "high"
    }
  },
  "taskPipelines": {
    "planning_architecture": ["claude-fable", "claude-opus", "gemini-flash"],
    "frontend_visual": ["gemini-flash", "claude-sonnet", "claude-opus"],
    "backend_core": ["claude-opus", "claude-fable", "claude-sonnet"],
    "tdd_debugging": ["claude-opus", "claude-fable", "claude-sonnet"],
    "static_review": ["claude-opus", "claude-fable", "claude-sonnet"],
    "delivery_evidence": ["gemini-flash", "claude-fable", "claude-sonnet"]
  },
  "ralph": {
    "fallbackChains": {
      "critic": ["gemini-flash", "claude-fable", "claude-sonnet"],
      "metaPrompter": ["claude-fable", "claude-opus", "gemini-flash"]
    },
    "defaults": {
      "task": "backend_core",
      "maxIterations": 6,
      "minimumCriticScore": 85
    }
  }
}
