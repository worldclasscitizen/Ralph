# 변수 이름 참고용입니다. npm Ralph는 OS 자격 증명 저장소를 우선합니다.
# OS 저장소를 쓸 수 없고 직접 API를 호출할 때만 shell 환경변수로 설정합니다.
# builtin CLI 로그인을 쓰면 해당 API key가 필요하지 않습니다.

OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Z.AI GLM Coding Plan
GLM_API_KEY=""
GLM_BASE_URL="https://api.z.ai/api/coding/paas/v4"
GLM_ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic"

# Z.AI GLM General API
GLM_GENERAL_API_KEY=""
GLM_GENERAL_BASE_URL="https://api.z.ai/api/paas/v4"
