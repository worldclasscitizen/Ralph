{
  "name": "@worldclasscitizen/ralph",
  "version": "0.2.0-beta.0",
  "description": "Platform-neutral Ralph loop orchestration CLI",
  "type": "module",
  "bin": {
    "ralph": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "integrations",
    "docs",
    "START_HERE.md",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke-install.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "overrides": {
    "vite": "6.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worldclasscitizen/multi-agent-ralph.git"
  }
}
